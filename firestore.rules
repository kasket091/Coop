rules_version = '2';

// Hilas Coop v2. Members see only their own records; co-makers see the requests that name them;
// the admin (one fixed sign-in email) sees and writes everything.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return signedIn() && request.auth.token.email == 'admin@hilas-coop.app'; }
    function isMember() { return signedIn() && exists(/databases/$(database)/documents/members/$(me())); }
    function isFounder(id) { return exists(/databases/$(database)/documents/founders/$(id)); }

    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    match /coop/{doc} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin();
    }

    // Typed name -> sign-in email. Get by exact hash only; nobody can list the names.
    match /logins/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }

    // Founding members' names, so a borrower can pick co-makers.
    match /founders/{id} {
      allow read: if isMember() || isAdmin();
      allow write: if isAdmin();
    }

    // money history: each member reads only their own; only the admin writes
    match /transactions/{id} {
      allow read: if isAdmin() || (isMember() && resource.data.memberId == me());
      allow write: if isAdmin();
    }

    match /members/{uid} {
      allow read: if isAdmin() || (signedIn() && me() == uid);
      allow write: if isAdmin();
    }

    match /loanRequests/{id} {
      function next() { return request.resource.data; }
      function prev() { return resource.data; }

      // isMember(), not signedIn(): a deleted member's old phone session loses access to requests
      allow read: if isAdmin()
        || (isMember() && (resource.data.borrowerId == me() || me() in resource.data.comakerIds));

      function meDoc() { return get(/databases/$(database)/documents/members/$(me())).data; }
      function ids() { return next().comakerIds; }
      function notAdminMember(id) { return get(/databases/$(database)/documents/founders/$(id)).data.name != 'Bryan Kevin Tabuan'; }
      // co-maker shapes (v3): none (deposit loan, or a founder within limit), the borrower's recruiter, or 2 founders (not Bryan)
      function validComakers() {
        return (ids().size() == 0 && (next().type == 'deposit' || isFounder(me())))
          || (ids().size() == 1 && ids()[0] == meDoc().recruiterId
              && next().comakers[ids()[0]].status == 'pending')
          || (ids().size() == 2 && ids()[0] != ids()[1] && !(me() in ids())
              && isFounder(ids()[0]) && isFounder(ids()[1]) && notAdminMember(ids()[0]) && notAdminMember(ids()[1])
              && next().comakers[ids()[0]].status == 'pending' && next().comakers[ids()[1]].status == 'pending');
      }

      allow create: if isMember()
        && next().keys().hasOnly(['borrowerId', 'borrowerName', 'type', 'amount', 'months', 'quote', 'comakers', 'comakerIds', 'status', 'createdAt', 'overLimit'])
        && next().borrowerId == me()
        && next().borrowerName == meDoc().name
        && next().status == 'pending'
        && next().type in ['regular', 'flex', 'grocery', 'appliance', 'events', 'deposit']
        && next().amount is number && next().amount > 0
        && next().months is int && next().months > 0
        && next().comakerIds is list && next().comakerIds.size() <= 2
        && next().comakers.keys().hasOnly(ids()) && next().comakers.size() == ids().size()
        && validComakers();

      allow update: if isAdmin()
        // a co-maker records only their own decision; declining closes the request
        || (isMember() && prev().status == 'pending' && me() in prev().comakerIds
            && next().diff(prev()).affectedKeys().hasOnly(['comakers', 'status'])
            && next().comakers.diff(prev().comakers).affectedKeys().hasOnly([me()])
            && next().comakers[me()].keys().hasOnly(['name', 'status', 'at'])
            && next().comakers[me()].name == prev().comakers[me()].name
            && next().comakers[me()].status in ['approved', 'declined']
            && (next().status == 'pending'
                || (next().status == 'declined' && next().comakers[me()].status == 'declined')))
        // the borrower can only withdraw a pending request
        || (isMember() && prev().status == 'pending' && prev().borrowerId == me()
            && next().diff(prev()).affectedKeys().hasOnly(['status'])
            && next().status == 'withdrawn');

      allow delete: if isAdmin();
    }
  }
}
